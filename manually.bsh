#!/usr/bin/env bash

set -e

echo "[1/4] Preparando directorios..."
mkdir -p iso/boot/grub bin

echo "[2/4] Copiando kernel..."
cp build/zoros.elf iso/boot/zoros.elf

echo "[3/4] Generando grub.cfg..."
cat > iso/boot/grub/grub.cfg <<'EOF'
set timeout=0
set default=0

menuentry "ZorOS" {
    multiboot2 /boot/zoros.elf
    boot
}
EOF

echo "[4/4] Generando ISO..."
grub-mkrescue \
    -d "$HOME/grub-prebuilt/grub/usr/lib/grub/i386-pc" \
    -o bin/zoros.iso \
    iso/

echo
echo "=== ISO GENERADA ==="
ls -lh bin/zoros.iso

echo
echo "=== EL TORITO ==="
xorriso -indev bin/zoros.iso -report_el_torito plain
